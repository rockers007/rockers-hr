# ============================================================
# Rockers HR — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/rockers_hr

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- JWT ---
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=equity-next-demo
AWS_REGION=us-east-1
AWS_CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net/

# --- SMTP Email ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Rockers HR <hr@example.com>"

# --- Google Calendar API ---
GOOGLE_CALENDAR_CLIENT_ID=your-calendar-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-calendar-client-secret

# --- App ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PORT=4000

# --- OpenRouter (LLM Chat) ---
OPENROUTER_API_KEY=your-openrouter-api-key
